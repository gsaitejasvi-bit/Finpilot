# FinPilot Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.

# Alpha Vantage - Real stock data (free tier: 25 req/day)
# Get your key at: https://www.alphavantage.co/support/#api-key
VITE_ALPHA_VANTAGE_KEY=

# Exchange Rate API - Real forex rates (free tier: 1500 req/month)
# Get your key at: https://www.exchangerate-api.com/
VITE_EXCHANGE_RATE_KEY=

# Setu AA (Account Aggregator) - Open Banking (India)
# Sandbox credentials from: https://setu.co/aa
VITE_SETU_CLIENT_ID=
VITE_SETU_CLIENT_SECRET=
VITE_SETU_BASE_URL=https://fiu-sandbox.setu.co

# Email notifications (optional - Resend.com free tier)
VITE_RESEND_API_KEY=

# App environment (development | production)
VITE_APP_ENV=development
